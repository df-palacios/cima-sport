PORT=4001

DB_HOST=localhost
DB_PORT=3306
DB_USER=cima_app
DB_PASSWORD=
DB_NAME=cima_sport

# Genera el tuyo y NO lo subas al repositorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=genera-el-tuyo-con-el-comando-de-arriba
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5175

# Permite el botón "[DEMO] Reiniciar datos". En una tienda real: false.
ALLOW_DEMO_RESET=true
